{
  "name": "@hnk/telemetry-control",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsup src/server.ts --format esm --platform node --out-dir dist --no-splitting",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hnk/telemetry-control-core": "workspace:*",
    "@hnk/telemetry-engine": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0"
  }
}
