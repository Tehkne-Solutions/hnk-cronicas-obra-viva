# Tehkné Solutions — HENUVOKODAN Telemetry Control Center
PORT=8787
DATABASE_URL=postgresql://user:password@host:5432/hnk_telemetry
HNK_TELEMETRY_DB_SSL=true
HNK_TELEMETRY_ADMIN_TOKEN=replace-with-a-long-random-token
HNK_TELEMETRY_ALLOWED_ORIGINS=https://game.example.com
HNK_TELEMETRY_RETENTION_DAYS=30
HNK_TELEMETRY_RATE_LIMIT_PER_MINUTE=300
HNK_TELEMETRY_ALERT_WEBHOOK=https://alerts.example.com/webhook
HNK_TELEMETRY_ALERT_MIN_LEVEL=warn
HNK_TELEMETRY_ALERT_COOLDOWN_MS=900000
HNK_RELEASE=production
HNK_BUILD_SHA=git-sha

# In the game-web deployment:
# VITE_HNK_TELEMETRY_ENDPOINT=https://telemetry.example.com/v1/telemetry
# VITE_HNK_RELEASE=production
# VITE_HNK_BUILD_SHA=git-sha
